{
  "entities": {
    "Presentation": {
      "title": "Presentation",
      "description": "A slide lecture presentation containing slides, elements, themes, and animations.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique presentation ID"
        },
        "title": {
          "type": "string",
          "description": "Title of the presentation"
        },
        "aspectRatio": {
          "type": "string",
          "description": "Screen aspect ratio (16:9 or 4:3)"
        },
        "themeId": {
          "type": "string",
          "description": "Theme preset identifier"
        },
        "author": {
          "type": "string",
          "description": "Author of the presentation"
        },
        "subject": {
          "type": "string",
          "description": "Subject of the presentation"
        },
        "grade": {
          "type": "string",
          "description": "Grade level"
        },
        "slidesJson": {
          "type": "string",
          "description": "Serialized JSON string of the slides array ensuring full fidelity and offline caching"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "lastEditorClientId": {
          "type": "string",
          "description": "Client ID of the last editor device"
        }
      },
      "required": ["id", "title", "slidesJson", "updatedAt"]
    },
    "AppState": {
      "title": "AppState",
      "description": "Global active state indicating the currently opened presentation for collaborative synchronization",
      "type": "object",
      "properties": {
        "activePresentationId": {
          "type": "string",
          "description": "ID of current active presentation"
        },
        "initialized": {
          "type": "boolean",
          "description": "Whether the cloud library has been initialized with default lectures"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last active change"
        },
        "lastEditorClientId": {
          "type": "string",
          "description": "Client ID of the last active editor"
        }
      },
      "required": ["activePresentationId", "updatedAt"]
    },
    "Member": {
      "title": "Member",
      "description": "A user member account issued by the Super Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique member identifier"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the member"
        },
        "phone": {
          "type": "string",
          "description": "Phone number used as login username"
        },
        "password": {
          "type": "string",
          "description": "Member account password"
        },
        "role": {
          "type": "string",
          "description": "Role type: member"
        },
        "permission": {
          "type": "string",
          "description": "Permission level: editor or viewer"
        },
        "status": {
          "type": "string",
          "description": "Account status: active or locked"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "createdBy": {
          "type": "string",
          "description": "Creator of the member account"
        }
      },
      "required": ["id", "fullName", "phone", "password", "role", "permission", "status", "updatedAt"]
    },
    "AdminAuth": {
      "title": "AdminAuth",
      "description": "Super admin credential and configuration document",
      "type": "object",
      "properties": {
        "adminPassword": {
          "type": "string",
          "description": "Super Admin private login password"
        },
        "adminName": {
          "type": "string",
          "description": "Display name of the Super Admin"
        },
        "adminEmail": {
          "type": "string",
          "description": "Optional contact email of the Super Admin"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of password update"
        }
      },
      "required": ["adminPassword", "updatedAt"]
    }
  },
  "firestore": {
    "/presentations/{presentationId}": {
      "schema": "Presentation",
      "description": "Shared repository of all presentations accessible across all devices"
    },
    "/system/{systemDocId}": {
      "schema": "AppState",
      "description": "Global application state synchronization document"
    },
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Registered member accounts manageable only by the Super Admin"
    },
    "/system/admin_auth": {
      "schema": "AdminAuth",
      "description": "Super admin security credentials document"
    }
  }
}
